# Copia este archivo a .env (local) o cárgalo como "Secrets" en el hosting. NUNCA lo subas con valores.
# Portal de claves: https://portal.api.coordinador.cl/admin/applications
CEN_USER_KEY=               # servicio Información Pública (SIP)
CEN_OPERACION_KEY=          # servicio Operación
# Opcional
# CEN_MIN_INTERVAL=1.5      # pausa mínima entre consultas (s)
# CEN_MODO_PUBLICO=1        # oculta "Forzar actualización" (protege el límite de consultas en despliegues públicos)
